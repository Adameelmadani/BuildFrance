# systemd - site vitrine BUILD FRANCE
# Installation : sudo cp deploy/buildfrance-site.service /etc/systemd/system/
#                sudo systemctl daemon-reload && sudo systemctl enable --now buildfrance-site
[Unit]
Description=BUILD FRANCE - site vitrine (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=buildfrance-site
Group=buildfrance-site
WorkingDirectory=/opt/buildfrance-site
EnvironmentFile=/opt/buildfrance-site/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

# Sécurité
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/buildfrance-site/data

[Install]
WantedBy=multi-user.target
