# Copiez ce fichier en .env puis complétez-le.

# ---------- Serveur ----------
# Adresse et port d'écoute de Node. Gardez 127.0.0.1 si Nginx tourne sur la même machine.
HOST=127.0.0.1
PORT=3100
# Nombre de proxys devant Node (1 = Nginx). 0 si Node est exposé directement.
TRUST_PROXY=1
# Dossier où sont conservées les demandes reçues (fichier messages.jsonl).
DATA_DIR=./data

# ---------- Envoi des e-mails (SMTP) ----------
# Gmail : smtp.gmail.com, port 465, SMTP_SECURE=true, et un « mot de passe d'application »
# (pas le mot de passe du compte). Voir le README, section « Envoi des e-mails ».
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=buildfrance.sas@gmail.com
SMTP_PASS=

# Adresse qui reçoit les demandes de devis.
MAIL_TO=buildfrance.sas@gmail.com
# Expéditeur affiché. Avec Gmail, il doit être l'adresse SMTP_USER.
MAIL_FROM="Site BUILD FRANCE <buildfrance.sas@gmail.com>"

# Fuseau horaire des dates dans les e-mails.
TZ=Europe/Paris
